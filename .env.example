# Qloo hackathon key. Works ONLY against https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Any OpenAI-compatible chat endpoint for the agent's planner (default: OpenRouter free model)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
# Leave QLOO_API_KEY empty to run in clearly labeled SAMPLE DATA mode.
