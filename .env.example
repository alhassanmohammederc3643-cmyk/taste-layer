# Qloo hackathon key. Works ONLY against https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Any OpenAI-compatible chat endpoint for the agent's planner (default: Groq)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Leave QLOO_API_KEY empty to run in clearly labeled SAMPLE DATA mode.
